services:
  owncast:
    image: owncast/owncast:latest
    container_name: owncast
    restart: always
    ports:
      - "1935:1935"
    volumes:
      # 沿用你指定的绝对路径
      - /root/data/docker_data/owncast/data:/app/data
      # 内存盘绝对路径
      - /dev/shm/owncast_hls:/app/data/hls
    networks:
      - owncast-net

  nginx:
    image: nginx:alpine
    container_name: owncast-nginx
    user: "0:0"
    restart: always
    ulimits:
      nproc: 65535
      nofile:
        soft: 65535
        hard: 65535
    ports:
      - "80:80"
    volumes:
      # 关键：这里使用相对路径读取 Git 仓库里的配置文件
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      # 内存盘绝对路径
      - /dev/shm/owncast_hls:/usr/share/nginx/html/hls:ro
    depends_on:
      - owncast
    networks:
      - owncast-net

networks:
  owncast-net:
    driver: bridge
